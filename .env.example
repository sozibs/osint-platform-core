# OSINT Platform – Environment Variables Example
# Copy to .env and fill in your values

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=changeme-in-production-use-a-long-random-string

# ── Push Notifications (VAPID) ─────────────────────────────────────────────
# Generate with: python -c "from backend.notifications.vapid_keys import get_vapid_keys; k=get_vapid_keys(); print(k)"
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# ── Frontend ───────────────────────────────────────────────────────────────
VITE_API_URL=/api
VITE_VAPID_PUBLIC_KEY=

# ── Database ───────────────────────────────────────────────────────────────
# Overrides the defaults in docker-compose.yml if needed
# DATABASE_URL=postgresql+asyncpg://osint:osint@postgres:5432/osint_core
# REDIS_URL=redis://redis:6379/0

# ── Optional external services ─────────────────────────────────────────────
# NEO4J_URL=bolt://neo4j:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
# ES_URL=http://elasticsearch:9200
# S3_ENDPOINT=
# S3_BUCKET=osint-files
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
